<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="play_quiz"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_quiz_short"
        android:shortcutLongLabel="@string/shortcut_quiz_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.quiz3web.mobile"
            android:targetClass="com.quiz3web.mobile.MainActivity"
            android:data="quickquiz://quiz" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <shortcut
        android:shortcutId="view_leaderboard"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_leaderboard_short"
        android:shortcutLongLabel="@string/shortcut_leaderboard_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.quiz3web.mobile"
            android:targetClass="com.quiz3web.mobile.MainActivity"
            android:data="quickquiz://leaderboard" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
