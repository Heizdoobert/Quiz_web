# ── Supabase ───────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Server-only. Also the root of the session cookie's HMAC key: rotating it signs everyone out.
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key

# ── Wallet / Web3 ─────────────────────────────────────────────────
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=YOUR_PROJECT_ID

# ── On-Chain: Contract Addresses (required) ───────────────────────
NEXT_PUBLIC_QUIZ_TOKEN_ADDRESS=0x_deployed_quiz_token_address
NEXT_PUBLIC_QUIZ_BADGE_ADDRESS=0x_deployed_quiz_badge_address
NEXT_PUBLIC_CONTEST_ESCROW_ADDRESS=0x_deployed_contest_escrow_address
NEXT_PUBLIC_CHAIN_ID=8453

# ── On-Chain: Reward Signing (required) ───────────────────────────
REWARD_SIGNER_PRIVATE_KEY=0x_your_signer_private_key

# ── App URL ────────────────────────────────────────────────────────
# Public base URL (canonical links, sitemap, Open Graph). Falls back to Vercel's production domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to "preview" to mark a non-Vercel deployment as preview (noindex).
NEXT_PUBLIC_APP_ENV=

# ── Optional ───────────────────────────────────────────────────────
# Sponsor ad link (defaults to https://coinzilla.com if unset)
NEXT_PUBLIC_SPONSOR_AD_URL=https://coinzilla.com
# Coinbase Developer Platform Paymaster URL for Gasless Transactions
NEXT_PUBLIC_PAYMASTER_URL=
# Receives $QUIZ swept from accounts without a wallet after 180 days. Unset = no sweep.
TREASURY_WALLET_ADDRESS=

# ── Hardhat Deployment (contracts/) ────────────────────────────────
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org
DEPLOYER_PRIVATE_KEY=
REWARD_SIGNER_ADDRESS=
BADGE_BASE_URI=https://your-domain.com/badges/
