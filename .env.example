# ── Supabase ───────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Server-only. Also the root of the session cookie's HMAC key: rotating it signs everyone out.
SUPABASE_SECRET_KEY=your_supabase_secret_key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key

# ── App URL ────────────────────────────────────────────────────────
# Public base URL (canonical links, sitemap, Open Graph). Falls back to Vercel's production domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to "preview" to mark a non-Vercel deployment as preview (noindex).
NEXT_PUBLIC_APP_ENV=

# ── Optional ───────────────────────────────────────────────────────
# Google Gemini key for AI question generation and moderation (read by @google/genai)
GEMINI_API_KEY=
# Sponsor ad link (defaults to https://coinzilla.com if unset)
NEXT_PUBLIC_SPONSOR_AD_URL=https://coinzilla.com

# ── SendGrid & Cron System Reports ────────────────────────────────────
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=system@quickquiz.app
PRODUCT_REPORT_EMAIL=product-team@yourcompany.com
CRON_SECRET=your_cron_secret_token

# Admin error tracking page (/admin/errors). Server-only. The token needs only the event:read scope.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
